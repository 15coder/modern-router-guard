{
  "expo": {
    "name": "سياج",
    "slug": "syajk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D14",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D14"
    },
    "assetBundlePatterns": [
      "**/*",
      "web-build/**"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D14"
      },
      "package": "com.siyaj.router",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "allowBackup": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "292d698f-53e7-4262-b86a-6a86f98cb6ba"
      }
    }
  }
}
